      "trigger": "press",
      "lines": [
        { "speaker": "npc_02", "text": "Feelin' a bit down today." },
        {
          "type": "choice",
		  "style": "vertical",
		  "title": "You doing [i]okay[/i]?",
          "options": [
            { "text": "Yeah I'm fine.",  "goto": "npc_02_fine" },
            { "text": "Not really.",     "goto": "npc_02_bad"  }
          ]
        }
      ]
    },
    {
      "id": "npc_02_fine",
      "lines": [
        { "speaker": "npc_02", "text": "Good. That's good." },
        { "speaker": "mae",    "text": "..." }
      ]
    },
    {
      "id": "npc_02_bad",
      "lines": [
        { "speaker": "npc_02", "text": "[wave]Hey. It's okay.[/wave]" },
        { "speaker": "mae",    "text": "[shake]Is it?[/shake]" }
